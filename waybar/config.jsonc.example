// Sumá "custom/coinwatch" a modules-left/center/right y copiá el bloque de abajo
{
  "modules-left": [
    "custom/coinwatch"
  ],

  "custom/coinwatch": {
    "exec": "~/.config/waybar/scripts/coinwatch.py",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/coinwatch_open.sh",
    "on-click-right": "~/.config/coinwatch/coinwatch_add.sh",
    "on-click-middle": "~/.config/coinwatch/coinwatch_bar.sh",
    "signal": 8
  }
}
